# EffStreak Firebase & API Configuration
# Copy this file to .env and insert your project credentials

# --- Firebase Web Configuration ---
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=effstreak-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=effstreak-app
VITE_FIREBASE_STORAGE_BUCKET=effstreak-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Platform API Credentials (Optional / Enhanced Limits) ---
# GitHub Personal Access Token for private commit tracking / avoiding rate limits (5000 req/hr)
VITE_GITHUB_TOKEN=

# YouTube Data API v3 Key for tracking study/watch history
VITE_YOUTUBE_API_KEY=

# Local Rainmeter / Android Sync Bridge Port
VITE_SYNC_BRIDGE_PORT=8765
