# EffStreak Supabase & SQLite Configuration
# Copy this file to .env and insert your credentials

# --- Supabase Cloud Database & Authentication Configuration ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Backend Service Role Key (Optional / Enhanced backend cloud bypass)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Embedded SQLite Local Database (Auto-initialized) ---
# Database file is stored automatically at: backend/data/effstreak.db
SQLITE_DB_PATH=backend/data/effstreak.db

# --- Platform API Credentials (Optional / Enhanced Limits) ---
# GitHub Personal Access Token for private commit tracking / avoiding rate limits (5000 req/hr)
VITE_GITHUB_TOKEN=

# YouTube Data API v3 Key for tracking study/watch history
VITE_YOUTUBE_API_KEY=

# Local Rainmeter / Android Sync Bridge Port
VITE_SYNC_BRIDGE_PORT=8765
